{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witwin.dev/schemas/channel-performance-1.0.0.json",
  "title": "Channel performance artifact",
  "type": "object",
  "required": ["schema", "benchmark", "scenario", "environment", "results"],
  "properties": {
    "schema": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "witwin.channel.performance"},
        "version": {"const": "1.0.0"}
      }
    },
    "benchmark": {"type": "string"},
    "scenario": {"type": "object"},
    "environment": {"type": "object"},
    "results": {}
  }
}
