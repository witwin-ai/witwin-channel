        gradIncidentDerivativeVectorZReal, gradIncidentDerivativeVectorZImag,
        gradIncidentJonesUReal, gradIncidentJonesUImag,
        gradIncidentJonesVReal, gradIncidentJonesVImag,
        gradIncidentDerivativeJonesUReal, gradIncidentDerivativeJonesUImag,
        gradIncidentDerivativeJonesVReal, gradIncidentDerivativeJonesVImag,
        gradIncidentBasisUX, gradIncidentBasisUY, gradIncidentBasisUZ,
        gradIncidentBasisVX, gradIncidentBasisVY, gradIncidentBasisVZ,
        gradIncidentBasisKX, gradIncidentBasisKY, gradIncidentBasisKZ,
        gradFace0OperatorM00Real, gradFace0OperatorM00Imag,
        gradFace0OperatorM01Real, gradFace0OperatorM01Imag,
        gradFace0OperatorM10Real, gradFace0OperatorM10Imag,
        gradFace0OperatorM11Real, gradFace0OperatorM11Imag,
        gradFace1OperatorM00Real, gradFace1OperatorM00Imag,
        gradFace1OperatorM01Real, gradFace1OperatorM01Imag,
        gradFace1OperatorM10Real, gradFace1OperatorM10Imag,
        gradFace1OperatorM11Real, gradFace1OperatorM11Imag,
        gradFace0EtaR, gradFace0Sigma, gradFace0Gain, gradFace0UseFresnel, gradFace0MaterialPresent,
        gradFace1EtaR, gradFace1Sigma, gradFace1Gain, gradFace1UseFresnel, gradFace1MaterialPresent
    );
    RxTensors rxGrad = RxTensors(gradRxX, gradRxY, gradRxZ);

    PairOutputs.Differential pairOutputGrad = loadPairOutputDifferential(outputGrad, ownership, rIdx);
    if (!complex3DifferentialAnyNonzero(pairOutputGrad.vectorField))
    {
        return;
    }

    DifferentialPair<PairInputs> pairInputs = diffPair(loadPairInputs(stateTensors, sIdx));
    DifferentialPair<float3> targetPos = diffPair(loadRx(rxTensors, rIdx));
    bwd_diff(computePairContribution)(pairInputs, targetPos, k, material, pairOutputGrad);
    atomicAddPairInputDifferential(stateGrad, sIdx, pairInputs.d);
    atomicAddRxDifferential(rxGrad, rIdx, targetPos.d);
}

[AutoPyBindCUDA]
[CUDAKernel]
void utdAccumulateBackwardFull(
    TensorView<int> stateIndex,
    TensorView<int> rxIndex,
    TensorView<int> ownershipCode,
    TensorView<float> edgePosX,
    TensorView<float> edgePosY,
    TensorView<float> edgePosZ,
