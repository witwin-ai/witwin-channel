    TensorView<float> incidentBasisUX,
    TensorView<float> incidentBasisUY,
    TensorView<float> incidentBasisUZ,
    TensorView<float> incidentBasisVX,
    TensorView<float> incidentBasisVY,
    TensorView<float> incidentBasisVZ,
    TensorView<float> incidentBasisKX,
    TensorView<float> incidentBasisKY,
    TensorView<float> incidentBasisKZ,
    TensorView<float> face0OperatorM00Real,
    TensorView<float> face0OperatorM00Imag,
    TensorView<float> face0OperatorM01Real,
    TensorView<float> face0OperatorM01Imag,
    TensorView<float> face0OperatorM10Real,
    TensorView<float> face0OperatorM10Imag,
    TensorView<float> face0OperatorM11Real,
    TensorView<float> face0OperatorM11Imag,
    TensorView<float> face1OperatorM00Real,
    TensorView<float> face1OperatorM00Imag,
    TensorView<float> face1OperatorM01Real,
    TensorView<float> face1OperatorM01Imag,
    TensorView<float> face1OperatorM10Real,
    TensorView<float> face1OperatorM10Imag,
    TensorView<float> face1OperatorM11Real,
    TensorView<float> face1OperatorM11Imag,
    TensorView<float> face0EtaR,
    TensorView<float> face0Sigma,
    TensorView<float> face0Gain,
    TensorView<float> face0UseFresnel,
    TensorView<float> face0MaterialPresent,
    TensorView<float> face1EtaR,
    TensorView<float> face1Sigma,
    TensorView<float> face1Gain,
    TensorView<float> face1UseFresnel,
    TensorView<float> face1MaterialPresent,
    TensorView<float> rxX,
    TensorView<float> rxY,
    TensorView<float> rxZ,
    TensorView<float> directReal,
    TensorView<float> directImag,
    TensorView<float> multiReal,
    TensorView<float> multiImag,
    TensorView<float> directVectorXReal,
    TensorView<float> directVectorXImag,
    TensorView<float> directVectorYReal,
    TensorView<float> directVectorYImag,
    TensorView<float> directVectorZReal,
    TensorView<float> directVectorZImag,
    TensorView<float> multiVectorXReal,
    TensorView<float> multiVectorXImag,
    TensorView<float> multiVectorYReal,
    TensorView<float> multiVectorYImag,
    TensorView<float> multiVectorZReal,
    TensorView<float> multiVectorZImag,
    TensorView<float> gradEdgePosX,
    TensorView<float> gradEdgePosY,
    TensorView<float> gradEdgePosZ,
    TensorView<float> gradEdgeDirX,
    TensorView<float> gradEdgeDirY,
    TensorView<float> gradEdgeDirZ,
    TensorView<float> gradN0X,
    TensorView<float> gradN0Y,
    TensorView<float> gradN0Z,
    TensorView<float> gradNnX,
    TensorView<float> gradNnY,
    TensorView<float> gradNnZ,
    TensorView<float> gradWedgeN,
    TensorView<float> gradSourcePosX,
    TensorView<float> gradSourcePosY,
    TensorView<float> gradSourcePosZ,
    TensorView<float> gradIncidentFieldReal,
    TensorView<float> gradIncidentFieldImag,
    TensorView<float> gradIncidentNormalDerivativeReal,
    TensorView<float> gradIncidentNormalDerivativeImag,
    TensorView<float> gradR0Real,
    TensorView<float> gradR0Imag,
    TensorView<float> gradRnReal,
    TensorView<float> gradRnImag,
    TensorView<float> gradIncidentVectorXReal,
    TensorView<float> gradIncidentVectorXImag,
    TensorView<float> gradIncidentVectorYReal,
    TensorView<float> gradIncidentVectorYImag,
    TensorView<float> gradIncidentVectorZReal,
    TensorView<float> gradIncidentVectorZImag,
    TensorView<float> gradIncidentDerivativeVectorXReal,
    TensorView<float> gradIncidentDerivativeVectorXImag,
    TensorView<float> gradIncidentDerivativeVectorYReal,
    TensorView<float> gradIncidentDerivativeVectorYImag,
    TensorView<float> gradIncidentDerivativeVectorZReal,
    TensorView<float> gradIncidentDerivativeVectorZImag,
    TensorView<float> gradIncidentJonesUReal,
    TensorView<float> gradIncidentJonesUImag,
    TensorView<float> gradIncidentJonesVReal,
    TensorView<float> gradIncidentJonesVImag,
    TensorView<float> gradIncidentDerivativeJonesUReal,
    TensorView<float> gradIncidentDerivativeJonesUImag,
    TensorView<float> gradIncidentDerivativeJonesVReal,
    TensorView<float> gradIncidentDerivativeJonesVImag,
    TensorView<float> gradIncidentBasisUX,
    TensorView<float> gradIncidentBasisUY,
    TensorView<float> gradIncidentBasisUZ,
    TensorView<float> gradIncidentBasisVX,
    TensorView<float> gradIncidentBasisVY,
    TensorView<float> gradIncidentBasisVZ,
    TensorView<float> gradIncidentBasisKX,
    TensorView<float> gradIncidentBasisKY,
    TensorView<float> gradIncidentBasisKZ,
    TensorView<float> gradFace0OperatorM00Real,
    TensorView<float> gradFace0OperatorM00Imag,
    TensorView<float> gradFace0OperatorM01Real,
    TensorView<float> gradFace0OperatorM01Imag,
    TensorView<float> gradFace0OperatorM10Real,
    TensorView<float> gradFace0OperatorM10Imag,
    TensorView<float> gradFace0OperatorM11Real,
    TensorView<float> gradFace0OperatorM11Imag,
    TensorView<float> gradFace1OperatorM00Real,
    TensorView<float> gradFace1OperatorM00Imag,
    TensorView<float> gradFace1OperatorM01Real,
    TensorView<float> gradFace1OperatorM01Imag,
    TensorView<float> gradFace1OperatorM10Real,
    TensorView<float> gradFace1OperatorM10Imag,
    TensorView<float> gradFace1OperatorM11Real,
    TensorView<float> gradFace1OperatorM11Imag,
    TensorView<float> gradFace0EtaR,
    TensorView<float> gradFace0Sigma,
    TensorView<float> gradFace0Gain,
    TensorView<float> gradFace0UseFresnel,
    TensorView<float> gradFace0MaterialPresent,
    TensorView<float> gradFace1EtaR,
    TensorView<float> gradFace1Sigma,
    TensorView<float> gradFace1Gain,
    TensorView<float> gradFace1UseFresnel,
    TensorView<float> gradFace1MaterialPresent,
    TensorView<float> gradRxX,
    TensorView<float> gradRxY,
    TensorView<float> gradRxZ,
    int nPairs,
    float k,
    MaterialParams material
)
{
    uint3 dispatchIdx = cudaThreadIdx() + cudaBlockIdx() * cudaBlockDim();
    int index = int(dispatchIdx.x);
    if (index >= nPairs)
    {
        return;
    }

    int sIdx = stateIndex[index];
    int rIdx = rxIndex[index];
    int ownership = ownershipCode[sIdx];

    StateTensors state = StateTensors(
        edgePosX, edgePosY, edgePosZ,
        edgeDirX, edgeDirY, edgeDirZ,
        n0X, n0Y, n0Z,
        nnX, nnY, nnZ,
        wedgeN,
        sourcePosX, sourcePosY, sourcePosZ,
        incidentFieldReal, incidentFieldImag,
        incidentNormalDerivativeReal, incidentNormalDerivativeImag,
        r0Real, r0Imag, rnReal, rnImag,
        incidentVectorXReal, incidentVectorXImag,
        incidentVectorYReal, incidentVectorYImag,
        incidentVectorZReal, incidentVectorZImag,
        incidentDerivativeVectorXReal, incidentDerivativeVectorXImag,
        incidentDerivativeVectorYReal, incidentDerivativeVectorYImag,
        incidentDerivativeVectorZReal, incidentDerivativeVectorZImag,
        incidentJonesUReal, incidentJonesUImag,
        incidentJonesVReal, incidentJonesVImag,
        incidentDerivativeJonesUReal, incidentDerivativeJonesUImag,
        incidentDerivativeJonesVReal, incidentDerivativeJonesVImag,
        incidentBasisUX, incidentBasisUY, incidentBasisUZ,
        incidentBasisVX, incidentBasisVY, incidentBasisVZ,
        incidentBasisKX, incidentBasisKY, incidentBasisKZ,
        face0OperatorM00Real, face0OperatorM00Imag,
        face0OperatorM01Real, face0OperatorM01Imag,
        face0OperatorM10Real, face0OperatorM10Imag,
        face0OperatorM11Real, face0OperatorM11Imag,
        face1OperatorM00Real, face1OperatorM00Imag,
        face1OperatorM01Real, face1OperatorM01Imag,
        face1OperatorM10Real, face1OperatorM10Imag,
        face1OperatorM11Real, face1OperatorM11Imag,
        face0EtaR, face0Sigma, face0Gain, face0UseFresnel, face0MaterialPresent,
        face1EtaR, face1Sigma, face1Gain, face1UseFresnel, face1MaterialPresent
    );
    RxTensors rx = RxTensors(rxX, rxY, rxZ);
    OutputTensors outputGrad = OutputTensors(
        directReal, directImag, multiReal, multiImag,
        directVectorXReal, directVectorXImag,
        directVectorYReal, directVectorYImag,
        directVectorZReal, directVectorZImag,
        multiVectorXReal, multiVectorXImag,
        multiVectorYReal, multiVectorYImag,
        multiVectorZReal, multiVectorZImag
    );
    StateTensors stateGrad = StateTensors(
        gradEdgePosX, gradEdgePosY, gradEdgePosZ,
        gradEdgeDirX, gradEdgeDirY, gradEdgeDirZ,
        gradN0X, gradN0Y, gradN0Z,
        gradNnX, gradNnY, gradNnZ,
        gradWedgeN,
        gradSourcePosX, gradSourcePosY, gradSourcePosZ,
        gradIncidentFieldReal, gradIncidentFieldImag,
        gradIncidentNormalDerivativeReal, gradIncidentNormalDerivativeImag,
        gradR0Real, gradR0Imag, gradRnReal, gradRnImag,
        gradIncidentVectorXReal, gradIncidentVectorXImag,
        gradIncidentVectorYReal, gradIncidentVectorYImag,
        gradIncidentVectorZReal, gradIncidentVectorZImag,
        gradIncidentDerivativeVectorXReal, gradIncidentDerivativeVectorXImag,
        gradIncidentDerivativeVectorYReal, gradIncidentDerivativeVectorYImag,
        gradIncidentDerivativeVectorZReal, gradIncidentDerivativeVectorZImag,
        gradIncidentJonesUReal, gradIncidentJonesUImag,
        gradIncidentJonesVReal, gradIncidentJonesVImag,
        gradIncidentDerivativeJonesUReal, gradIncidentDerivativeJonesUImag,
        gradIncidentDerivativeJonesVReal, gradIncidentDerivativeJonesVImag,
        gradIncidentBasisUX, gradIncidentBasisUY, gradIncidentBasisUZ,
        gradIncidentBasisVX, gradIncidentBasisVY, gradIncidentBasisVZ,
        gradIncidentBasisKX, gradIncidentBasisKY, gradIncidentBasisKZ,
        gradFace0OperatorM00Real, gradFace0OperatorM00Imag,
        gradFace0OperatorM01Real, gradFace0OperatorM01Imag,
        gradFace0OperatorM10Real, gradFace0OperatorM10Imag,
        gradFace0OperatorM11Real, gradFace0OperatorM11Imag,
        gradFace1OperatorM00Real, gradFace1OperatorM00Imag,
        gradFace1OperatorM01Real, gradFace1OperatorM01Imag,
        gradFace1OperatorM10Real, gradFace1OperatorM10Imag,
        gradFace1OperatorM11Real, gradFace1OperatorM11Imag,
        gradFace0EtaR, gradFace0Sigma, gradFace0Gain, gradFace0UseFresnel, gradFace0MaterialPresent,
        gradFace1EtaR, gradFace1Sigma, gradFace1Gain, gradFace1UseFresnel, gradFace1MaterialPresent
    );
    RxTensors rxGrad = RxTensors(gradRxX, gradRxY, gradRxZ);

    DifferentialPair<PairInputs> pairInputs = diffPair(loadPairInputs(state, sIdx));
    DifferentialPair<float3> targetPos = diffPair(loadRx(rx, rIdx));
    PairOutputs.Differential pairOutputGrad = loadPairOutputDifferential(outputGrad, ownership, rIdx);

    bwd_diff(computePairContribution)(pairInputs, targetPos, k, material, pairOutputGrad);
    atomicAddPairInputDifferential(stateGrad, sIdx, pairInputs.d);
    atomicAddRxDifferential(rxGrad, rIdx, targetPos.d);
}
