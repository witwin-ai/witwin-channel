        tangentIncidentBasisVX, tangentIncidentBasisVY, tangentIncidentBasisVZ,
        tangentIncidentBasisKX, tangentIncidentBasisKY, tangentIncidentBasisKZ,
        tangentFace0OperatorM00Real, tangentFace0OperatorM00Imag,
        tangentFace0OperatorM01Real, tangentFace0OperatorM01Imag,
        tangentFace0OperatorM10Real, tangentFace0OperatorM10Imag,
        tangentFace0OperatorM11Real, tangentFace0OperatorM11Imag,
        tangentFace1OperatorM00Real, tangentFace1OperatorM00Imag,
        tangentFace1OperatorM01Real, tangentFace1OperatorM01Imag,
        tangentFace1OperatorM10Real, tangentFace1OperatorM10Imag,
        tangentFace1OperatorM11Real, tangentFace1OperatorM11Imag,
        tangentFace0EtaR, tangentFace0Sigma, tangentFace0Gain, tangentFace0UseFresnel, tangentFace0MaterialPresent,
        tangentFace1EtaR, tangentFace1Sigma, tangentFace1Gain, tangentFace1UseFresnel, tangentFace1MaterialPresent
    );
    RxTensors rx = RxTensors(rxX, rxY, rxZ);
    RxTensors rxTangent = RxTensors(tangentRxX, tangentRxY, tangentRxZ);
    OutputTensors outputTangent = OutputTensors(
        directReal, directImag, multiReal, multiImag,
        directVectorXReal, directVectorXImag,
        directVectorYReal, directVectorYImag,
        directVectorZReal, directVectorZImag,
        multiVectorXReal, multiVectorXImag,
        multiVectorYReal, multiVectorYImag,
        multiVectorZReal, multiVectorZImag
    );

    DifferentialPair<PairInputs> pairInputs = diffPair(
        loadPairInputs(state, sIdx),
        loadPairInputDifferential(stateTangent, sIdx)
    );
    DifferentialPair<float3> targetPos = diffPair(
        loadRx(rx, rIdx),
        loadRx(rxTangent, rIdx)
    );
    DifferentialPair<Complex> pairField = fwd_diff(computePairFieldContributionAssumeSafe)(pairInputs, targetPos, k, material);
    atomicAddComplex(outputTangent, ownership, rIdx, pairField.d);
}

