    TensorView<float> face0OperatorM01Real,
    TensorView<float> face0OperatorM01Imag,
    TensorView<float> face0OperatorM10Real,
    TensorView<float> face0OperatorM10Imag,
    TensorView<float> face0OperatorM11Real,
    TensorView<float> face0OperatorM11Imag,
    TensorView<float> face1OperatorM00Real,
    TensorView<float> face1OperatorM00Imag,
    TensorView<float> face1OperatorM01Real,
    TensorView<float> face1OperatorM01Imag,
    TensorView<float> face1OperatorM10Real,
    TensorView<float> face1OperatorM10Imag,
    TensorView<float> face1OperatorM11Real,
    TensorView<float> face1OperatorM11Imag,
    TensorView<float> face0EtaR,
    TensorView<float> face0Sigma,
    TensorView<float> face0Gain,
    TensorView<float> face0UseFresnel,
    TensorView<float> face0MaterialPresent,
    TensorView<float> face1EtaR,
    TensorView<float> face1Sigma,
    TensorView<float> face1Gain,
    TensorView<float> face1UseFresnel,
    TensorView<float> face1MaterialPresent,
    TensorView<float> tangentIncidentJonesUReal,
    TensorView<float> tangentIncidentJonesUImag,
    TensorView<float> tangentIncidentJonesVReal,
    TensorView<float> tangentIncidentJonesVImag,
    TensorView<float> tangentIncidentDerivativeJonesUReal,
    TensorView<float> tangentIncidentDerivativeJonesUImag,
    TensorView<float> tangentIncidentDerivativeJonesVReal,
    TensorView<float> tangentIncidentDerivativeJonesVImag,
    TensorView<float> tangentIncidentBasisUX,
    TensorView<float> tangentIncidentBasisUY,
    TensorView<float> tangentIncidentBasisUZ,
    TensorView<float> tangentIncidentBasisVX,
    TensorView<float> tangentIncidentBasisVY,
    TensorView<float> tangentIncidentBasisVZ,
    TensorView<float> tangentIncidentBasisKX,
    TensorView<float> tangentIncidentBasisKY,
    TensorView<float> tangentIncidentBasisKZ,
    TensorView<float> tangentFace0OperatorM00Real,
    TensorView<float> tangentFace0OperatorM00Imag,
    TensorView<float> tangentFace0OperatorM01Real,
    TensorView<float> tangentFace0OperatorM01Imag,
    TensorView<float> tangentFace0OperatorM10Real,
    TensorView<float> tangentFace0OperatorM10Imag,
    TensorView<float> tangentFace0OperatorM11Real,
    TensorView<float> tangentFace0OperatorM11Imag,
    TensorView<float> tangentFace1OperatorM00Real,
    TensorView<float> tangentFace1OperatorM00Imag,
    TensorView<float> tangentFace1OperatorM01Real,
    TensorView<float> tangentFace1OperatorM01Imag,
    TensorView<float> tangentFace1OperatorM10Real,
    TensorView<float> tangentFace1OperatorM10Imag,
    TensorView<float> tangentFace1OperatorM11Real,
    TensorView<float> tangentFace1OperatorM11Imag,
    TensorView<float> tangentFace0EtaR,
    TensorView<float> tangentFace0Sigma,
    TensorView<float> tangentFace0Gain,
    TensorView<float> tangentFace0UseFresnel,
    TensorView<float> tangentFace0MaterialPresent,
    TensorView<float> tangentFace1EtaR,
    TensorView<float> tangentFace1Sigma,
    TensorView<float> tangentFace1Gain,
    TensorView<float> tangentFace1UseFresnel,
    TensorView<float> tangentFace1MaterialPresent,
    TensorView<float> rxX,
    TensorView<float> rxY,
    TensorView<float> rxZ,
    TensorView<float> tangentRxX,
    TensorView<float> tangentRxY,
    TensorView<float> tangentRxZ,
    TensorView<float> directReal,
    TensorView<float> directImag,
    TensorView<float> multiReal,
    TensorView<float> multiImag,
    TensorView<float> directVectorXReal,
    TensorView<float> directVectorXImag,
    TensorView<float> directVectorYReal,
    TensorView<float> directVectorYImag,
    TensorView<float> directVectorZReal,
    TensorView<float> directVectorZImag,
    TensorView<float> multiVectorXReal,
    TensorView<float> multiVectorXImag,
    TensorView<float> multiVectorYReal,
    TensorView<float> multiVectorYImag,
    TensorView<float> multiVectorZReal,
    TensorView<float> multiVectorZImag,
    int nPairs,
    float k,
    MaterialParams material
)
{
    uint3 dispatchIdx = cudaThreadIdx() + cudaBlockIdx() * cudaBlockDim();
    int index = int(dispatchIdx.x);
    if (index >= nPairs)
    {
        return;
    }

    int sIdx = stateIndex[index];
    int rIdx = rxIndex[index];
    int ownership = ownershipCode[sIdx];

    StateTensors state = StateTensors(
        edgePosX, edgePosY, edgePosZ,
        edgeDirX, edgeDirY, edgeDirZ,
        n0X, n0Y, n0Z,
        nnX, nnY, nnZ,
        wedgeN,
        sourcePosX, sourcePosY, sourcePosZ,
        incidentFieldReal, incidentFieldImag,
        incidentNormalDerivativeReal, incidentNormalDerivativeImag,
        r0Real, r0Imag, rnReal, rnImag,
        incidentVectorXReal, incidentVectorXImag,
        incidentVectorYReal, incidentVectorYImag,
        incidentVectorZReal, incidentVectorZImag,
        incidentDerivativeVectorXReal, incidentDerivativeVectorXImag,
        incidentDerivativeVectorYReal, incidentDerivativeVectorYImag,
        incidentDerivativeVectorZReal, incidentDerivativeVectorZImag,
        incidentJonesUReal, incidentJonesUImag,
        incidentJonesVReal, incidentJonesVImag,
        incidentDerivativeJonesUReal, incidentDerivativeJonesUImag,
        incidentDerivativeJonesVReal, incidentDerivativeJonesVImag,
        incidentBasisUX, incidentBasisUY, incidentBasisUZ,
        incidentBasisVX, incidentBasisVY, incidentBasisVZ,
        incidentBasisKX, incidentBasisKY, incidentBasisKZ,
        face0OperatorM00Real, face0OperatorM00Imag,
        face0OperatorM01Real, face0OperatorM01Imag,
        face0OperatorM10Real, face0OperatorM10Imag,
        face0OperatorM11Real, face0OperatorM11Imag,
        face1OperatorM00Real, face1OperatorM00Imag,
        face1OperatorM01Real, face1OperatorM01Imag,
        face1OperatorM10Real, face1OperatorM10Imag,
        face1OperatorM11Real, face1OperatorM11Imag,
        face0EtaR, face0Sigma, face0Gain, face0UseFresnel, face0MaterialPresent,
        face1EtaR, face1Sigma, face1Gain, face1UseFresnel, face1MaterialPresent
    );
    StateTensors stateTangent = StateTensors(
        tangentEdgePosX, tangentEdgePosY, tangentEdgePosZ,
        tangentEdgeDirX, tangentEdgeDirY, tangentEdgeDirZ,
        tangentN0X, tangentN0Y, tangentN0Z,
        tangentNnX, tangentNnY, tangentNnZ,
        tangentWedgeN,
        tangentSourcePosX, tangentSourcePosY, tangentSourcePosZ,
        tangentIncidentFieldReal, tangentIncidentFieldImag,
        tangentIncidentNormalDerivativeReal, tangentIncidentNormalDerivativeImag,
        tangentR0Real, tangentR0Imag, tangentRnReal, tangentRnImag,
        tangentIncidentVectorXReal, tangentIncidentVectorXImag,
        tangentIncidentVectorYReal, tangentIncidentVectorYImag,
        tangentIncidentVectorZReal, tangentIncidentVectorZImag,
        tangentIncidentDerivativeVectorXReal, tangentIncidentDerivativeVectorXImag,
        tangentIncidentDerivativeVectorYReal, tangentIncidentDerivativeVectorYImag,
        tangentIncidentDerivativeVectorZReal, tangentIncidentDerivativeVectorZImag,
        tangentIncidentJonesUReal, tangentIncidentJonesUImag,
        tangentIncidentJonesVReal, tangentIncidentJonesVImag,
        tangentIncidentDerivativeJonesUReal, tangentIncidentDerivativeJonesUImag,
        tangentIncidentDerivativeJonesVReal, tangentIncidentDerivativeJonesVImag,
        tangentIncidentBasisUX, tangentIncidentBasisUY, tangentIncidentBasisUZ,
        tangentIncidentBasisVX, tangentIncidentBasisVY, tangentIncidentBasisVZ,
        tangentIncidentBasisKX, tangentIncidentBasisKY, tangentIncidentBasisKZ,
        tangentFace0OperatorM00Real, tangentFace0OperatorM00Imag,
        tangentFace0OperatorM01Real, tangentFace0OperatorM01Imag,
        tangentFace0OperatorM10Real, tangentFace0OperatorM10Imag,
        tangentFace0OperatorM11Real, tangentFace0OperatorM11Imag,
        tangentFace1OperatorM00Real, tangentFace1OperatorM00Imag,
        tangentFace1OperatorM01Real, tangentFace1OperatorM01Imag,
        tangentFace1OperatorM10Real, tangentFace1OperatorM10Imag,
        tangentFace1OperatorM11Real, tangentFace1OperatorM11Imag,
        tangentFace0EtaR, tangentFace0Sigma, tangentFace0Gain, tangentFace0UseFresnel, tangentFace0MaterialPresent,
        tangentFace1EtaR, tangentFace1Sigma, tangentFace1Gain, tangentFace1UseFresnel, tangentFace1MaterialPresent
    );
    RxTensors rx = RxTensors(rxX, rxY, rxZ);
    RxTensors rxTangent = RxTensors(tangentRxX, tangentRxY, tangentRxZ);
    OutputTensors outputTangent = OutputTensors(
        directReal, directImag, multiReal, multiImag,
        directVectorXReal, directVectorXImag,
        directVectorYReal, directVectorYImag,
        directVectorZReal, directVectorZImag,
        multiVectorXReal, multiVectorXImag,
        multiVectorYReal, multiVectorYImag,
        multiVectorZReal, multiVectorZImag
    );

    DifferentialPair<PairInputs> pairInputs = diffPair(
        loadPairInputs(state, sIdx),
        loadPairInputDifferential(stateTangent, sIdx)
    );
    DifferentialPair<float3> targetPos = diffPair(
        loadRx(rx, rIdx),
        loadRx(rxTangent, rIdx)
    );
    DifferentialPair<PairOutputs> pairOutputs = fwd_diff(computePairContribution)(pairInputs, targetPos, k, material);
    atomicAddPairOutput(outputTangent, ownership, rIdx, pairOutputs.d);
}
