        face0EtaR, face0Sigma, face0Gain, face0UseFresnel, face0MaterialPresent,
        face1EtaR, face1Sigma, face1Gain, face1UseFresnel, face1MaterialPresent
    );
    StateTensors stateTangent = StateTensors(
        tangentEdgePosX, tangentEdgePosY, tangentEdgePosZ,
        tangentEdgeDirX, tangentEdgeDirY, tangentEdgeDirZ,
        tangentN0X, tangentN0Y, tangentN0Z,
        tangentNnX, tangentNnY, tangentNnZ,
        tangentWedgeN,
        tangentSourcePosX, tangentSourcePosY, tangentSourcePosZ,
        tangentIncidentFieldReal, tangentIncidentFieldImag,
        tangentIncidentNormalDerivativeReal, tangentIncidentNormalDerivativeImag,
        tangentR0Real, tangentR0Imag, tangentRnReal, tangentRnImag,
